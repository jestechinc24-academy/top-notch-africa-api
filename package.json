{
  "name": "top_notch_africa_api",
  "version": "1.0.0",
  "description": "NDGP - National Donor & Government Projects Platform (OTDI) backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run migrate && node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "6.6.2"
  }
}
