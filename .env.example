NODE_ENV=development
PORT=5000

DB_NAME=ndgp_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=12h

# Shared password for the admin panel (single login, no user accounts).
# Set this to something only your team knows.
ADMIN_PASSWORD=change_me_before_deploying
